# Local only. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Bangkok

# PostgreSQL database created by the developer. URL-encode special password characters.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dijango
DATABASE_CONNECT_TIMEOUT=3
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=django_base_local
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
# Để trống để dùng host-only cookie.
REFRESH_TOKEN_COOKIE_DOMAIN=
LOGIN_THROTTLE_RATE=5/min
REFRESH_THROTTLE_RATE=10/min
REGISTER_THROTTLE_RATE=5/hour
PASSWORD_RESET_THROTTLE_RATE=5/hour
EVENT_THROTTLE_RATE=120/min

# Checkout COD (VND)
SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=1000000

# VNPay sandbox. Secret thật chỉ đặt trong .env local, không commit.
PAYMENT_RESERVATION_MINUTES=15
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
EXCHANGE_WINDOW_DAYS=30
EXCHANGE_RESERVATION_MINUTES=1440
# 0 = chỉ dùng REMOTE_ADDR. Đặt đúng số reverse proxy tin cậy khi production.
DRF_NUM_PROXIES=0
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

# Password reset email. `auto` dùng SMTP khi điền đủ host/user/password, nếu thiếu sẽ in ra terminal.
FRONTEND_BASE_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_BACKEND=auto
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# Chỉ dùng với lệnh seed_dev_user khi DEBUG=true. Hãy đổi mật khẩu nếu cần.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=123456

# Production reverse proxy settings
USE_X_FORWARDED_HOST=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
